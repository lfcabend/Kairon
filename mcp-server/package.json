{
  "name": "kairon-mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone MCP server bridging a user's own Claude Code session to Kairon's assistant features (docs/milestones/M10.5-mcp-server.md). Thin, stateless REST client — holds no credential of its own.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
