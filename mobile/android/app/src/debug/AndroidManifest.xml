<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
    M11.4 — debug-only overlay (AGP merges this into the main manifest for
    debug builds only): allows cleartext HTTP, needed for the emulator-dev
    default (http://10.0.2.2:8080/kairon/). The release manifest carries no
    such override, so a release build stays cleartext-blocked by Android's
    own default — correct for the real target, the xbmc deploy's Tailscale
    Funnel hostname, which is HTTPS.
    -->
    <application android:usesCleartextTraffic="true" />

</manifest>
